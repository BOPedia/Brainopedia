{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "^/brainopedia-clean/(?!assets|images|favicon|_next)(.*)$",
      "destination": "/brainopedia-clean/index.html"
    }
  ],
  "headers": [
    {
      "source": "/brainopedia-clean/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/brainopedia-clean/assets/(.*)",
      "destination": "/brainopedia-clean/assets/$1"
    },
    {
      "source": "/brainopedia-clean/(.*\\.\\w+)$",
      "destination": "/brainopedia-clean/$1"
    },
    {
      "source": "/brainopedia-clean/.*",
      "destination": "/brainopedia-clean/index.html"
    }
  ],
  "headers": [
    {
      "source": "/brainopedia-clean/assets/(.*\\.js)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript"
        }
      ]
    }
  ]
}

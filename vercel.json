{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/brainopedia-clean/assets/(.*)",
      "destination": "/brainopedia-clean/assets/$1"
    },
    {
      "source": "/brainopedia-clean/(.*\\.\\w+)$",
      "destination": "/brainopedia-clean/$1"
    },
    {
      "source": "/brainopedia-clean/.*",
      "destination": "/brainopedia-clean/index.html"
    }
  ],
  "headers": [
    {
      "source": "/brainopedia-clean/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/brainopedia-clean/assets/(.*\\.(js|mjs))",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/brainopedia-clean/assets/(.*\\.css)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        }
      ]
    },
    {
      "source": "/brainopedia-clean/(.*\\.wasm)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        }
      ]
    }
  ]
}
